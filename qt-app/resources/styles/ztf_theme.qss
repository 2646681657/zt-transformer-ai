QMainWindow {
    background-color: #f0f0f0;
}

/* Ribbon Bar */
#RibbonBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4a7aba, stop:0.5 #3a6aaa, stop:1 #2a5a9a);
    border-bottom: 1px solid #1e4070;
}

#RibbonGroup {
    background: transparent;
}

#RibbonGroupTitle {
    color: #d0e0f0;
    font-size: 10px;
    padding: 1px 0;
    background: transparent;
}

#RibbonSeparator {
    color: #5a8aca;
}

#RibbonButton {
    background: transparent;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 11px;
}

#RibbonButton:hover {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

#RibbonButton:checked, #RibbonButton[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffd700, stop:1 #daa520);
    color: #1a1a1a;
    border: 1px solid #b8860b;
}

/* Tables */
QTableWidget {
    background: white;
    color: #333333;
    gridline-color: #ddd;
    font-size: 12px;
    selection-background-color: #cde4f7;
    selection-color: #000;
}

QTableWidget::item {
    color: #333333;
    padding: 2px 4px;
}

QHeaderView::section {
    background: #e8eef4;
    color: #333;
    padding: 4px;
    border: 1px solid #ccc;
    font-size: 11px;
    font-weight: bold;
}

/* General text elements */
QLabel {
    color: #333333;
}

/* Title bar at top of pages */
#PageTitleBar {
    background: #1e4070;
    color: white;
    font-size: 12px;
}

/* Labels inside Ribbon must be light */
#RibbonBar QLabel {
    color: #d0e0f0;
    background: transparent;
}

/* All controls inside Ribbon: white text */
#RibbonBar QToolButton {
    background: transparent;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 11px;
}

#RibbonBar QToolButton:hover {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

#RibbonBar QToolButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffd700, stop:1 #daa520);
    color: #1a1a1a;
    border: 1px solid #b8860b;
}

QLineEdit {
    color: #333;
    background: white;
    border: 1px solid #ccc;
    border-radius: 3px;
    padding: 3px 6px;
}

QComboBox {
    color: #333;
    background: white;
    border: 1px solid #ccc;
    border-radius: 3px;
    padding: 3px 6px;
}

QPushButton {
    color: #333;
}

/* Message Box dialogs */
QMessageBox {
    background: white;
}

QMessageBox QLabel {
    color: #333;
    font-size: 13px;
}

QMessageBox QPushButton {
    background: #e8e8e8;
    color: #333;
    border: 1px solid #bbb;
    border-radius: 4px;
    padding: 5px 18px;
    min-width: 60px;
}

QMessageBox QPushButton:hover {
    background: #d0d0d0;
}

QTextEdit {
    color: #333;
    background: #f8f8f8;
}

QTabWidget::pane {
    border: 1px solid #ccc;
    background: white;
}

QTabBar::tab {
    background: #e0e0e0;
    color: #333;
    padding: 6px 16px;
    border: 1px solid #ccc;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: white;
    color: #2a5a9a;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #f0f0f0;
}
