/* ===== Excel 风格绿色 / 白色主题 ===== */

QMainWindow {
    background-color: #F3F5F4;
}

/* ===== Ribbon Bar ===== */
#RibbonBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #EDF3EF, stop:1 #FFFFFF);
    border-bottom: 1px solid #D3DDD6;
}

#RibbonGroup {
    background: transparent;
}

#RibbonGroupTitle {
    color: #607368;
    font-size: 10px;
    padding: 1px 0;
    background: transparent;
}

#RibbonSeparator {
    color: #D3DDD6;
}

/* Ribbon 按钮 */
#RibbonBar QToolButton {
    background: transparent;
    color: #24362B;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

#RibbonBar QToolButton:hover {
    background: rgba(33, 115, 70, 0.15);
    border: 1px solid rgba(33, 115, 70, 0.4);
}

#RibbonBar QToolButton:checked {
    background: #DCEEDF;
    color: #185C37;
    border: 1px solid #185C37;
}

#RibbonButton {
    background: transparent;
    color: #24362B;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

#RibbonButton:hover {
    background: rgba(33, 115, 70, 0.15);
    border: 1px solid rgba(33, 115, 70, 0.4);
}

#RibbonButton:checked, #RibbonButton[active="true"] {
    background: #DCEEDF;
    color: #185C37;
    border: 1px solid #185C37;
}

/* ===== 表格 ===== */
QTableWidget {
    background: #FFFFFF;
    color: #24362B;
    gridline-color: #D3DDD6;
    font-size: 12px;
    selection-background-color: #E7F2EA;
    selection-color: #185C37;
    border: 1px solid #D3DDD6;
}

QTableWidget::item {
    color: #24362B;
    padding: 3px 5px;
    border-bottom: 1px solid #EDF3EF;
}

QTableWidget::item:alternate {
    background: #F7FAF8;
}

QTableWidget::item:selected {
    background: #E7F2EA;
    color: #185C37;
}

QHeaderView::section {
    background: #EDF3EF;
    color: #607368;
    padding: 5px 6px;
    border: none;
    border-right: 1px solid #D3DDD6;
    border-bottom: 1px solid #D3DDD6;
    font-size: 11px;
    font-weight: bold;
}

/* ===== 通用控件 ===== */
QLabel {
    color: #24362B;
}

#PageTitleBar {
    background: #217346;
    border-bottom: 1px solid #217346;
}

#RibbonBar QLabel {
    color: #607368;
    background: transparent;
}

/* ===== 输入控件 ===== */
QLineEdit {
    color: #24362B;
    background: #F3F5F4;
    border: 1px solid #D3DDD6;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QLineEdit:focus {
    border: 1px solid #217346;
    background: #F7FAF8;
}

QComboBox {
    color: #24362B;
    background: #F3F5F4;
    border: 1px solid #D3DDD6;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QComboBox:focus, QComboBox:on {
    border: 1px solid #217346;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #24362B;
    border: 1px solid #D3DDD6;
    selection-background-color: #E7F2EA;
    selection-color: #185C37;
}

QPushButton {
    color: #24362B;
    background: #EDF3EF;
    border: 1px solid #D3DDD6;
    border-radius: 4px;
    padding: 5px 14px;
}

QPushButton:hover {
    background: #D3DDD6;
    border-color: #185C37;
}

QPushButton:pressed {
    background: #185C37;
    color: white;
}

/* ===== 消息对话框 ===== */
QMessageBox {
    background: #FFFFFF;
}

QMessageBox QLabel {
    color: #24362B;
    font-size: 13px;
}

QMessageBox QPushButton {
    background: #EDF3EF;
    color: #24362B;
    border: 1px solid #D3DDD6;
    border-radius: 4px;
    padding: 6px 20px;
    min-width: 70px;
}

QMessageBox QPushButton:hover {
    background: rgba(33, 115, 70, 0.2);
    border-color: #217346;
}

/* ===== 文本编辑 ===== */
QTextEdit {
    color: #24362B;
    background: #F7FAF8;
    border: 1px solid #D3DDD6;
    border-radius: 4px;
}

/* ===== Tab 控件 ===== */
QTabWidget::pane {
    border: 1px solid #D3DDD6;
    background: #F3F5F4;
    border-top: 2px solid #217346;
}

QTabBar::tab {
    background: #FFFFFF;
    color: #607368;
    padding: 7px 18px;
    border: 1px solid #D3DDD6;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #F3F5F4;
    color: #185C37;
    font-weight: bold;
    border-top: 2px solid #217346;
}

QTabBar::tab:hover:!selected {
    background: #EDF3EF;
    color: #24362B;
}

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    background: #F3F5F4;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #D3DDD6;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #217346;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #F3F5F4;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #D3DDD6;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #217346;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ===== GroupBox ===== */
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #D3DDD6;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 12px;
    font-weight: bold;
    color: #185C37;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #185C37;
}

/* ===== RadioButton / CheckBox ===== */
QRadioButton, QCheckBox {
    color: #24362B;
    spacing: 6px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #D3DDD6;
    border-radius: 3px;
    background: #F3F5F4;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background: #217346;
    border-color: #217346;
}

/* ===== Dialog ===== */
QDialog {
    background: #FFFFFF;
}

/* 未单独设置样式的编辑器、菜单和进度提示也使用浅色主题。 */
QSpinBox, QDoubleSpinBox, QPlainTextEdit {
    background: #FFFFFF;
    color: #24362B;
    border: 1px solid #D3DDD6;
    border-radius: 4px;
}

QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border-color: #217346;
}

QMenu, QToolTip {
    background: #FFFFFF;
    color: #24362B;
    border: 1px solid #D3DDD6;
}

QMenu::item:selected {
    background: #E7F2EA;
    color: #185C37;
}

QProgressBar {
    background: #EDF3EF;
    color: #24362B;
    border: 1px solid #D3DDD6;
    text-align: center;
}

QProgressBar::chunk {
    background: #217346;
}
